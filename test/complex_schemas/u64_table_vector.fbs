namespace protocol;

// Alignment regression fixture: a vector of tables with u64 fields, inside a
// union member table.
table Item {
  name: string (required);
  data: [ubyte];
  a: uint64;
  b: uint64;
}

table Bulk {
  tag: string;
  items: [Item] (required);
}

union Body { Bulk }

table Envelope {
  id: uint64;
  body: Body (required);
}

root_type Envelope;
